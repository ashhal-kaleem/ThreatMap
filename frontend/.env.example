# Copy to frontend/.env (or .env.local) and adjust. Only VITE_* vars reach the browser.

# API base URL for deployed builds, e.g. https://threatmap-api.example.com
# Leave empty in local development to use the Vite proxy below.
VITE_API_BASE_URL=

# Dev-server settings
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173

# Fallback upload limit (MB) until the backend reports its own via /health
VITE_MAX_UPLOAD_MB=50

# Rows per page in the IOC table
VITE_IOC_PAGE_SIZE=25
