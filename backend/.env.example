# ThreatMap Lite Backend — Environment Configuration Template
# Copy this file to `.env` inside `backend/` and supply actual values locally.
# NEVER commit the actual `.env` file to version control.

# Google Gemini API Key (Required for Phase 3+ AI Summary & Tips)
GEMINI_API_KEY=your_gemini_api_key_here

# Database. Leave DATABASE_URL unset to use the local SQLite file (backend/threatmap.db),
# which needs no setup. For PostgreSQL, install a driver first (pip install "psycopg[binary]"),
# start Postgres, then uncomment and use the postgresql+psycopg:// scheme:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/threatmap

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Storage Settings
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=50

# Comma-separated browser origins allowed by CORS (frontend dev server / deployed URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
