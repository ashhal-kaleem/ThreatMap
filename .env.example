# ThreatMap Lite — Environment Configuration Template
# Copy this file to `.env` and supply actual values locally.
# NEVER commit the actual `.env` file to version control.

# Google Gemini API Key (Required for Phase 3+ AI Summary & Tips)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL (Required for Phase 1+ DB Persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatmap

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Storage Settings
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=50
